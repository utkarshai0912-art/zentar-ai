# Zentar Intelligence — Environment Variables
# Copy to .env and fill in your values

# Application
APP_NAME=Zentar Intelligence
APP_VERSION=2.0.0
DEBUG=false
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/zentar

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption
ENCRYPTION_KEY=your-32-byte-encryption-key-here!

# AI Providers (add your keys)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Web Search
TAVILY_API_KEY=
SERPAPI_API_KEY=

# Browser Automation
PLAYWRIGHT_HEADLESS=true

# Logging
LOG_LEVEL=INFO
